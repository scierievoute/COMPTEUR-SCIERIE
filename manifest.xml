<?xml version="1.0" encoding="UTF-8" standalone="yes"?>

<OfficeApp
    xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
    xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
    xsi:type="TaskPaneApp">

    <Id>4c0c5e9a-85f7-4d89-b06e-74f6e9c7d421</Id>

    <Version>1.0.0.0</Version>

    <ProviderName>Scierie Voute</ProviderName>

    <DefaultLocale>fr-FR</DefaultLocale>

    <DisplayName DefaultValue="Compteur Scierie"/>

    <Description DefaultValue="Compteur de production pour la Scierie Voute"/>

    <IconUrl DefaultValue="https://scierievoute.github.io/COMPTEUR-SCIERIE/icon.png"/>

    <HighResolutionIconUrl DefaultValue="https://scierievoute.github.io/COMPTEUR-SCIERIE/icon.png"/>

    <SupportUrl DefaultValue="https://scierievoute.github.io/COMPTEUR-SCIERIE/"/>


    <AppDomains>

        <AppDomain>
            https://scierievoute.github.io
        </AppDomain>

    </AppDomains>


    <Hosts>

        <Host Name="Workbook"/>

    </Hosts>


    <DefaultSettings>

        <SourceLocation
            DefaultValue="https://scierievoute.github.io/COMPTEUR-SCIERIE/"/>

    </DefaultSettings>


    <Permissions>
        ReadWriteDocument
    </Permissions>


    <VersionOverrides
        xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
        xsi:type="VersionOverridesV1_0">

        <Hosts>

            <Host xsi:type="Workbook">

                <DesktopFormFactor>

                    <GetStarted>

                        <Title resid="GetStarted.Title"/>

                        <Description resid="GetStarted.Description"/>

                        <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>

                    </GetStarted>


                    <FunctionFile resid="Commands.Url"/>


                    <ExtensionPoint xsi:type="PrimaryCommandSurface">

                        <OfficeTab id="TabHome">

                            <Group id="Scierie.Group">

                                <Label resid="Scierie.GroupLabel"/>


                                <Control
                                    xsi:type="Button"
                                    id="Scierie.OpenButton">

                                    <Label resid="Scierie.ButtonLabel"/>

                                    <Supertip>

                                        <Title resid="Scierie.ButtonLabel"/>

                                        <Description resid="Scierie.ButtonDescription"/>

                                    </Supertip>

                                    <Icon>

                                        <bt:Image
                                            size="16"
                                            resid="Icon.16"/>

                                        <bt:Image
                                            size="32"
                                            resid="Icon.32"/>

                                        <bt:Image
                                            size="80"
                                            resid="Icon.80"/>

                                    </Icon>


                                    <Action xsi:type="ShowTaskpane">

                                        <TaskpaneId>
                                            ButtonId1
                                        </TaskpaneId>

                                        <SourceLocation
                                            resid="Taskpane.Url"/>

                                    </Action>

                                </Control>

                            </Group>

                        </OfficeTab>

                    </ExtensionPoint>

                </DesktopFormFactor>

            </Host>

        </Hosts>


        <Resources>

            <bt:Images>

                <bt:Image
                    id="Icon.16"
                    DefaultValue="https://scierievoute.github.io/COMPTEUR-SCIERIE/icon.png"/>

                <bt:Image
                    id="Icon.32"
                    DefaultValue="https://scierievoute.github.io/COMPTEUR-SCIERIE/icon.png"/>

                <bt:Image
                    id="Icon.80"
                    DefaultValue="https://scierievoute.github.io/COMPTEUR-SCIERIE/icon.png"/>

            </bt:Images>


            <bt:Urls>

                <bt:Url
                    id="GetStarted.LearnMoreUrl"
                    DefaultValue="https://scierievoute.github.io/COMPTEUR-SCIERIE/"/>

                <bt:Url
                    id="Commands.Url"
                    DefaultValue="https://scierievoute.github.io/COMPTEUR-SCIERIE/"/>

                <bt:Url
                    id="Taskpane.Url"
                    DefaultValue="https://scierievoute.github.io/COMPTEUR-SCIERIE/"/>

            </bt:Urls>


            <bt:ShortStrings>

                <bt:String
                    id="GetStarted.Title"
                    DefaultValue="Compteur Scierie installé"/>

                <bt:String
                    id="Scierie.GroupLabel"
                    DefaultValue="SCIERIE"/>

                <bt:String
                    id="Scierie.ButtonLabel"
                    DefaultValue="Compteur Scierie"/>

            </bt:ShortStrings>


            <bt:LongStrings>

                <bt:String
                    id="GetStarted.Description"
                    DefaultValue="Le Compteur Scierie est prêt à être utilisé."/>

                <bt:String
                    id="Scierie.ButtonDescription"
                    DefaultValue="Ouvrir le panneau Compteur Scierie"/>

            </bt:LongStrings>

        </Resources>

    </VersionOverrides>

</OfficeApp>
